# Copy to .env and change every password:  cp .env.example .env
# .env is git-ignored. Both docker compose and the services (run from the IDE) read it.

# Postgres superuser: used only to initialise the database, never by the services.
POSTGRES_PASSWORD=change-me-postgres

# Least-privilege role the services connect as.
DB_USER=flashsale_app
DB_PASSWORD=change-me-app

# Schema owner. Only the one-shot db-migrate container (Flyway) uses it; the services never do.
DB_MIGRATOR_PASSWORD=change-me-migrator

# Redis: operator account (redis-cli), and one user per service. Hex or alphanumeric only.
REDIS_PASSWORD=change-me-redis
REDIS_SALE_PASSWORD=change-me-redis-sale
REDIS_ORDER_PASSWORD=change-me-redis-order

# Enables POST /admin/sales/{id}/reset, which deletes a sale's orders. Local testing only.
RESET_ENABLED=true

# Minutes before an unpaid order is cancelled and its unit returns to stock (use 1 when testing).
PAYMENT_TIMEOUT_MINUTES=10

# Grafana admin login (user: admin), http://localhost:3000
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Keycloak (http://localhost:8180): admin console login is "admin" / KEYCLOAK_ADMIN_PASSWORD.
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
# Password of the demo users buyer1, buyer2 and shopadmin (at least 12 characters).
DEMO_USER_PASSWORD=change-me-demo-user

# Load tests only (docker-compose.loadtest.yml): HMAC secret k6 signs its own user tokens with.
# At least 32 characters. The normal stack ignores it.
LOADTEST_JWT_SECRET=change-me-loadtest-secret-at-least-32-chars

# Optional ops assistant for admins (POST localhost:8090/admin/assistant/summary): an AI-written status report from
# aggregate numbers only (stock, order counts, dead-letter counts, firing alerts; never user ids or order data).
# Leave empty to keep it off. Create a key at platform.openai.com; set a monthly budget limit there too.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
