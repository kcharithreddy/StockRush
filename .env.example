# Copy to .env and change every password:  cp .env.example .env
# .env is git-ignored. Both docker compose and the services (run from the IDE) read it.

# Postgres superuser: used only to initialise the database, never by the services.
POSTGRES_PASSWORD=change-me-postgres

# Least-privilege role the services connect as.
DB_USER=flashsale_app
DB_PASSWORD=change-me-app

REDIS_PASSWORD=change-me-redis

# Enables POST /admin/sales/{id}/reset, which deletes a sale's orders. Local testing only.
RESET_ENABLED=true

# Minutes before an unpaid order is cancelled and its unit returns to stock (use 1 when testing).
PAYMENT_TIMEOUT_MINUTES=10

# Grafana admin login (user: admin), http://localhost:3000
GRAFANA_ADMIN_PASSWORD=change-me-grafana
